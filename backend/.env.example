# ---- app ---------------------------------------------------------------
ENV=dev
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- database (MySQL / XAMPP) ------------------------------------------
DATABASE_URL=mysql+pymysql://root:@localhost:3306/fantom

# ---- queue (unused - scans run on an in-process worker, see app/workers/runner.py)
REDIS_URL=redis://localhost:6379/0

# ---- auth ---------------------------------------------------------------
JWT_SECRET=change-me-to-a-random-32-byte-string-in-production
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30
FRONTEND_URL=http://localhost:5173

# ---- outbound email (password reset, invitations) - optional; unset means
# reset/invite links are logged instead of emailed -----------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fantom.ai

# ---- GitHub App (Part 1, pre-connector - left running as-is) -----------
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
# PEM with literal \n between lines
GITHUB_PRIVATE_KEY=

# ---- GitHub connector (Connector V1) -----------------------------------
# OAuth App - create one at https://github.com/settings/developers.
# Callback URL there must match GITHUB_REDIRECT_URI exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/connectors/github/callback
# base64, decodes to exactly 32 bytes - generate with:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
GITHUB_ENCRYPTION_KEY=
# set only while rotating GITHUB_ENCRYPTION_KEY (old value goes here, new value
# replaces GITHUB_ENCRYPTION_KEY) - remove once every row has been rotated
GITHUB_ENCRYPTION_KEY_PREVIOUS=
# optional
GITHUB_API_BASE=https://api.github.com
GITHUB_SYNC_PAGE_SIZE=100
GITHUB_CLONE_TIMEOUT=120
CONNECTOR_SYNC_INTERVAL_HOURS=6

# ---- LLM (Part 5) ------------------------------------------------------
OPENROUTER_API_KEY=

# ---- risk model --------------------------------------------------------
DEFAULT_ENG_RATE_HOUR=120
